NODE_ENV=production
APP_URL=https://app.example.com
DATABASE_URL=postgresql://talentoco:change-me@db.example.com:5432/talentoco?schema=public

# Required secrets
AUTH_SECRET=replace-with-64-plus-random-chars
OPAQUE_ID_SECRET=replace-with-64-plus-random-chars
PRIVATE_MEDIA_TOKEN_SECRET=replace-with-64-plus-random-chars
CERTIFICATION_MEDIA_TOKEN_SECRET=replace-with-64-plus-random-chars
RETENTION_RUNNER_SECRET=replace-with-64-plus-random-chars
CHAT_OUTBOX_RUNNER_SECRET=replace-with-64-plus-random-chars
CHAT_MESSAGE_ACTIVE_KEY_VERSION=1
CHAT_MESSAGE_KEYS_JSON={"1":"replace-with-base64-32-byte-key"}
CHAT_BAD_WORDS_PATH=/home/mike/Escritorio/malas.txt

# Stripe
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Resend
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=alerts@example.com

# Object storage (S3 / R2 / MinIO compatible)
OBJECT_STORAGE_ENDPOINT=https://object-storage.example.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=talento-co-assets
OBJECT_STORAGE_ACCESS_KEY_ID=replace-me
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-me

# Only enable if you're behind a trusted proxy/load balancer
TRUST_PROXY_HEADERS_FOR_RATE_LIMIT=false
